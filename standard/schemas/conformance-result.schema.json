{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IAmSoThirsty/TS4-IIMP-001/standard/schemas/conformance-result.schema.json",
  "title": "TS4-IIMP-001 Conformance Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "record_check_performed", "no_prohibited_default", "symmetric_fidelity", "integration_verified", "audit_completeness", "safety_compatibility", "passed"],
  "properties": {
    "case_id": {"type": "string"},
