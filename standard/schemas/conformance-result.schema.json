    "no_prohibited_default": {"type": "boolean"},
    "symmetric_fidelity": {"type": "boolean"},
    "integration_verified": {"type": "boolean"},
    "audit_completeness": {"type": "boolean"},
    "safety_compatibility": {"type": "boolean"},
    "passed": {"type": "boolean"}
  }
}
