{
  "name": "ts4-iimp-001-reference-typescript",
  "version": "1.1.0",
  "description": "TypeScript reference implementation of TS4-IIMP-001 v1.1.0 — Interpretive Integrity and Meaning-Preservation Standard",
  "license": "Apache-2.0",
  "author": "Jeremy Karrick",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test dist/test/mpdp-engine.test.js",
    "pretest": "tsc",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
